?pcre
fpc_mom <- function(R, G, pve = 0.95) {
# etichette di gruppo + Res (ogni record è un livello)
Z  <- c(lapply(G, as.character), list(Res = as.character(seq_len(nrow(R)))))
nk <- length(Z)
nT <- ncol(R)
# A[k, l] = n. coppie (i, j) che condividono sia g_k che g_l
A <- matrix(0, nk, nk, dimnames = list(names(Z), names(Z)))
for (k in 1:nk) for (l in 1:nk)
A[k, l] <- sum(table(paste(Z[[k]], Z[[l]]))^2)
# b_k = U'U, con U = somme dei residui per livello
B <- sapply(Z, function(z) {
U <- rowsum(R, z)
c(crossprod(U))
})
# A K(t,t') = b(t,t') per tutte le (t,t')
K <- B %*% solve(A)
# FPC di ciascuna K_k
fpc <- lapply(names(G), function(k) {
Kk <- matrix(K[, k], nT, nT)
e  <- eigen(Kk, symmetric = TRUE)
v  <- pmax(e$values, 0)
M  <- which(cumsum(v) / sum(v) >= pve)[1]
list(efunctions = e$vectors[, 1:M, drop = FALSE], evalues = v[1:M])
})
names(fpc) <- names(G)
fpc
}
f0   <- as.formula(paste("Y ~", paste(names(Xl)[-1], collapse = " + ")))
fit0 <- pffr(f0, yind = tt, data = df, algorithm = "bam", bs.int = basi)
R0   <- residuals(fit0)
fit0 <- pffr(f0, yind = tt, data = df, algorithm = "bam", bs.int = basi)
basi <- list(bs = "bs", k = 10, m = c(3, 2))
fit.pffr <- pffr(f, yind = tt, data = df, algorithm = "bam", bs.int = basi)
f0   <- as.formula(paste("Y ~", paste(names(Xl)[-1], collapse = " + ")))
fit0 <- pffr(f0, yind = tt, data = df, algorithm = "bam", bs.int = basi)
R0   <- residuals(fit0)
# FPC di Station, Event, Source
grp <- c("Station", "Event", "Source")
fpc <- fpc_mom(R0, df[grp], pve = 0.95)
sapply(fpc, function(x) length(x$evalues))
# pcre vuole efunctions/evalues come variabili semplici
for (g in grp) {
assign(paste0("Phi.", g), fpc[[g]]$efunctions)
assign(paste0("nu.", g),  fpc[[g]]$evalues)
}
re.pc <- paste0("pcre(id = ", grp, ", efunctions = Phi.", grp,
", evalues = nu.", grp, ", yind = tt)")
f.pc     <- as.formula(paste("Y ~", paste(c(names(Xl)[-1], re.pc), collapse = " + ")))
fit.pcre <- pffr(f.pc, yind = tt, data = df, algorithm = "bam", bs.int = basi)
